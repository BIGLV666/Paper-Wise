<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.paperwise.Mapper.ChatSessionMapper">
    <select id="getAllHistory" resultType="org.example.paperwise.entry.ChatSession">
        select * from chat_session where user_id=#{userId} ORDER BY update_time DeSC
    </select>
</mapper>