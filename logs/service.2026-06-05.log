2026-06-05 20:08:10.115 INFO  [http-nio-8080-exec-2] ServiceLogger - Object[Card(cardId=56, userid=1, title=什么是SpringBoot?, options=null, answer=通过Spring Boot，可以轻松地创建独立的，基于生产级别的Spring的应用程序，您可以“运行”它们。大多数Spring Boot应用程序需要最少的Spring配置。, explanation=Spring Boot 是一个用于快速构建 Spring 应用程序的框架，简化了配置和依赖管理。, questionType=SPRINGBOOT, cardType=ESSAY, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=57, userid=1, title=SpringBoot的特征有哪些？, options=null, answer=创建独立的Spring应用程序、直接嵌入Tomcat、Jetty或Undertow、提供固化的starter依赖项、自动配置Spring和3rd Party库、提供用于生产的功能, explanation=Spring Boot 的特征包括简化配置、内嵌服务器、自动配置等。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=MEDIUM, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=58, userid=1, title=如何快速构建一个SpringBoot项目？, options=null, answer=通过Web界面使用http://start.spring.io、通过Spring Tool Suite使用、通过IntelliJ IDEA使用、使用Spring Boot CLI使用, explanation=Spring Boot 提供多种方式来快速构建项目，包括在线工具、IDE插件和命令行工具。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=59, userid=1, title=SpringBoot启动类注解是什么？它由哪些注解组成？, options=null, answer=@SpringBootApplication、@SpringBootConfiguration、@EnableAutoConfiguration、@ComponentScan, explanation=@SpringBootApplication 是组合注解，包含 @SpringBootConfiguration、@EnableAutoConfiguration 和 @ComponentScan。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=MEDIUM, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=60, userid=1, title=什么是YAML？, options=null, answer=YAML（/ˈjæməl/）是一个可读性高，用来表达数据序列化的格式。YAML参考了其他多种语言，包括C语言、Python、Perl，更具有结构性。, explanation=YAML 是一种结构化数据格式，常用于配置文件，比 properties 更易读。, questionType=SPRINGBOOT, cardType=ESSAY, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=61, userid=1, title=SpringBoot支持哪些配置文件格式？, options=null, answer=properties、yml, explanation=SpringBoot 支持 properties 和 YAML 格式的配置文件。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=62, userid=1, title=SpringBoot的启动方式有哪些？, options=null, answer=main方法、命令行 java -jar 的方式、mvn/gradle, explanation=SpringBoot 可以通过 main 方法、命令行方式或构建工具启动。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=63, userid=1, title=SpringBoot是否需要独立的容器运行？, options=null, answer=不需要, explanation=SpringBoot 内置了 Tomcat/Jetty，无需额外部署到外部容器。, questionType=SPRINGBOOT, cardType=TRUE_FALSE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=64, userid=1, title=SpringBoot的配置途径有哪些？, options=null, answer=命令行参数、JNDI属性、JVM系统属性、操作系统环境变量、随机生成的带random.*前缀的属性、application.properties/yml 文件、@PropertySource标注的属性源、默认属性, explanation=SpringBoot 提供了多种配置方式，并按优先级排序。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=MEDIUM, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=65, userid=1, title=application.properties 和 application.yml 文件可放置的位置及其优先级是怎样的？, options=null, answer=外置，在相对于应用程序运行目录的/config子目录里、外置，在应用程序运行的目录里、内置，在config包内、内置，在Classpath根目录, explanation=这些位置按优先级排序，高优先级覆盖低优先级。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=MEDIUM, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=66, userid=1, title=SpringBoot自动配置原理是什么？, options=null, answer=@EnableAutoConfiguration 注解引入了 AutoConfigurationImportSelector，该类中方法会扫描所有存在 META-INF/spring.factories 的 jar 包。, explanation=SpringBoot 自动配置通过扫描 spring.factories 文件实现。, questionType=SPRINGBOOT, cardType=ESSAY, cardDifficulty=MEDIUM, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=67, userid=1, title=SpringBoot热部署方式有哪些？, options=null, answer=spring-boot-devtools、Spring Loaded、Jrebel、模版热部署, explanation=SpringBoot 支持多种热部署方式，提升开发效率。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=MEDIUM, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=68, userid=1, title=bootstrap.yml 和 application.yml 的区别是什么？, options=null, answer=bootstrap.yml 优先于 application.yml, explanation=bootstrap.yml 在 application.yml 之前加载，优先级更高。, questionType=SPRINGBOOT, cardType=TRUE_FALSE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=69, userid=1, title=如何修改SpringBoot的端口号？, options=null, answer=可以通过命令行：java -jar xiaoka.jar --spring.config.location=/home/application.yml 或者在 yml 文件中设置 server.port=8888。, explanation=SpringBoot 可以通过配置文件或命令行参数修改端口号。, questionType=SPRINGBOOT, cardType=ESSAY, cardDifficulty=MEDIUM, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=70, userid=1, title=开启SpringBoot特性的几种方式有哪些？, options=null, answer=继承 spring-boot-starter-parent 项目、导入 spring-boot-dependencies 项目依赖, explanation=SpringBoot 特性可以通过继承 starter-parent 或导入 dependencies 来开启。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=71, userid=1, title=SpringBoot如何兼容Spring项目？, options=null, answer=在启动类加 @ImportResource(locations = {"classpath:spring.xml"})、server.port=8888、java -Dserver.port=8888 -jar xiaoka.jar, explanation=SpringBoot 可以通过配置文件、启动类注解等方式兼容传统 Spring 项目。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=MEDIUM, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=72, userid=1, title=获得Bean装配报告信息访问哪个端点？, options=null, answer=/beans, explanation=/beans 端点提供 Bean 装配报告信息。, questionType=SPRINGBOOT, cardType=SINGLE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=73, userid=1, title=关闭应用程序访问哪个端点？, options=null, answer=/shutdown, explanation=/shutdown 端点用于关闭 SpringBoot 应用程序。, questionType=SPRINGBOOT, cardType=SINGLE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=74, userid=1, title=查看发布应用信息访问哪个端点？, options=null, answer=/info, explanation=/info 端点提供应用信息。, questionType=SPRINGBOOT, cardType=SINGLE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=75, userid=1, title=针对请求访问的几个组合注解有哪些？, options=null, answer=@PatchMapping、@PostMapping、@GetMapping、@PutMapping、@DeleteMapping, explanation=这些注解用于处理不同 HTTP 请求方法。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=76, userid=1, title=SpringBoot中的starter是什么？, options=null, answer=starter 是对依赖的一种合成，会把一个或一套功能相关依赖都包含进来，避免了自己去依赖费事，还有各种包的冲突问题。, explanation=SpringBoot Starter 简化了依赖管理，提高开发效率。, questionType=SPRINGBOOT, cardType=ESSAY, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=77, userid=1, title=SpringBoot集成Mybatis的方式是什么？, options=null, answer=mybatis-spring-boot-starter, explanation=SpringBoot 集成 MyBatis 可以通过 mybatis-spring-boot-starter 依赖。, questionType=SPRINGBOOT, cardType=SINGLE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=78, userid=1, title=什么是SpringProfiles？, options=null, answer=Spring Profiles 允许用户根据配置文件（dev, test, prod 等）来注册 bean，可以在不同环境下使用不同的配置。, explanation=Spring Profiles 用于区分不同环境下的配置。, questionType=SPRINGBOOT, cardType=ESSAY, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=79, userid=1, title=不同的环境的配置文件有哪些？, options=null, answer=application.properties、application-dev.properties、application-test.properties、application-prod.properties, explanation=不同环境的配置文件命名规则为 application-{profile}.properties/yml。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=80, userid=1, title=如何激活某个环境的配置？, options=null, answer=可以通过 yml 中设置 spring.profiles.active=dev 或者命令行参数 --spring.profiles.active=dev 激活特定环境。, explanation=激活环境配置可以通过配置文件或命令行参数完成。, questionType=SPRINGBOOT, cardType=ESSAY, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=81, userid=1, title=编写测试用例的注解是什么？, options=null, answer=@SpringBootTest, explanation=@SpringBootTest 注解用于编写 SpringBoot 测试用例。, questionType=SPRINGBOOT, cardType=SINGLE, cardDifficulty=EASY, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=82, userid=1, title=SpringBoot异常处理相关注解有哪些？, options=null, answer=@ControllerAdvice、@ExceptionHandler, explanation=这两个注解用于全局异常处理。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=MEDIUM, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=83, userid=1, title=SpringBoot 1.x 和 2.x 的区别有哪些？, options=null, answer=基于Spring5和JDK8、配置变更、插件版本要求更高、中文配置支持、Actuator变化、CacheManager变化, explanation=SpringBoot 2.x 在底层依赖、配置、性能等方面进行了优化。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=HARD, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=84, userid=1, title=SpringBoot读取配置相关注解有哪些？, options=null, answer=@PropertySource、@Value、@Environment、@ConfigurationProperties, explanation=这些注解用于从配置中读取值。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=MEDIUM, cardMastery=NOT_STARTED, createTime=2026-06-03T11:00:18), Card(cardId=85, userid=1, title=SpringBoot读取配置相关注解有？, options=null, answer=@PropertySource、@Value、@Environment、@ConfigurationProperties, explanation=SpringBoot 中用于读取配置的注解包括 @PropertySource、@Value、@Environment 和 @ConfigurationProperties。, questionType=SPRINGBOOT, cardType=MULTIPLE, cardDifficulty=MEDIUM, cardMastery=NOT_STARTED, createTime=2026-06-03T11:37:12)]
